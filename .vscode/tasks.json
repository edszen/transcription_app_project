{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "unittest",
                "discover",
                "-v",
                "-s",
                "tests",
                "-p",
                "test_*.py"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Run Current Test File",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "unittest",
                "-v",
                "${relativeFile}"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}